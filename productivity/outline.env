# Outline Environment Configuration
# URL вашего Outline
URL=https://wiki.ai.ulanevg.ru
PORT=3000

# Секреты
SECRET_KEY=change_this_to_random_string_32_chars
UTILS_SECRET=change_this_to_different_random_string_32_chars

# База данных
DATABASE_URL=postgres://outline:outline_secret@outline-postgres:5432/outline
PGSSLMODE=disable

# Redis
REDIS_URL=redis://outline-redis:6379

# MinIO (локальное SMC хранилище для файлов)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_secret_change_me
AWS_REGION=us-east-1
AWS_S3_UPLOAD_BUCKET_NAME=outline
AWS_S3_UPLOAD_BUCKET_URL=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_UPLOAD_MAX_SIZE=26214400

# Локальное хранилище (фолбек)
FILE_STORAGE=s3
FILE_STORAGE_UPLOAD_MAX_SIZE=26214400

# Принудительно HTTPS
FORCE_HTTPS=true

# Отключаем Google OAuth - используем локальную аутентификацию через MinIO
# Outline НЕ поддерживает встроенный логин/пароль без OAuth.
# Для личного использования проще использовать Google OAuth.
# Инструкция по настройке в README.md
