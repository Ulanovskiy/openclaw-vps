# Vikunja Environment Configuration
# URL вашего Vikunja
VIKUNJA_SERVICE_PUBLICURL=https://tasks.ai.ulanevg.ru
VIKUNJA_SERVICE_FRONTENDURL=https://tasks.ai.ulanevg.ru

# Секрет для JWT токенов (сгенерируй случайную строку)
VIKUNJA_SERVICE_JWTSECRET=change_this_to_random_long_string

# База данных PostgreSQL
VIKUNJA_DATABASE_TYPE=postgres
VIKUNJA_DATABASE_HOST=vikunja-db
VIKUNJA_DATABASE_PORT=5432
VIKUNJA_DATABASE_USER=vikunja
VIKUNJA_DATABASE_PASSWORD=vikunja_secret
VIKUNJA_DATABASE_DATABASE=vikunja

# Включить вложения
VIKUNJA_SERVICE_ENABLETASKATTACHMENTS=1

# Регистрация (отключить после создания аккаунта для безопасности)
VIKUNJA_SERVICE_ENABLEREGISTRATION=1

# Напоминания по email (опционально)
VIKUNJA_SERVICE_ENABLEEMAILREMINDERS=0

# Таймаут сессии (30 дней)
VIKUNJA_SERVICE_SESSION_DURATION=2592000
