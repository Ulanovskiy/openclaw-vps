# Environment variables for OpenClaw VPS
# Copy to .env and fill in your values

# Domain Configuration
DOMAIN=ai.ulanevg.ru
EMAIL=admin@ulanevg.ru
TZ=Europe/Moscow

# Database (auto-generated by install.sh)
DB_PASSWORD=change_this_secure_password
REDIS_PASSWORD=change_this_secure_password
JWT_SECRET=change_this_secret_key

# Paths
INSTALL_DIR=/opt/openclaw

# Optional API Keys (can be set in Web UI)
# OPENAI_API_KEY=sk-...
# TELEGRAM_BOT_TOKEN=...
# TAVILY_API_KEY=...
